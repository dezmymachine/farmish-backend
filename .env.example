# Farmish backend environment.
#
#   cp .env.example .env    then fill in real values in .env (gitignored).
#
# This file is sourced by the shell (`make run`, `make migrate-*`), so:
#   - no spaces around `=`
#   - wrap values containing & ; spaces, quotes, $ or # in single quotes.
#     An unquoted & silently drops the variable (the shell backgrounds it),
#     e.g. Neon URLs with ?sslmode=require&channel_binding=require.
#   - use TEST/sandbox credentials locally; live keys go only in Railway
#
# Empty values are placeholders. The API only reads a variable once the phase
# that needs it has landed, and then fails fast at startup if it's missing.

# ----------------------------------------------------------------------------
# Core (Phases 1-2): required now
# ----------------------------------------------------------------------------

# development | test | staging | production
APP_ENV=development
# Comma-separated browser origin allowlist (no *)
CORS_ORIGINS=http://localhost:3000
# Postgres URL. The default is the docker-compose database (`make db-up`).
# Neon: use the DIRECT connection string (not the -pooler host), in single quotes:
#   DATABASE_URL='postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
DATABASE_URL=postgres://farmish:farmish@127.0.0.1:54320/farmish?sslmode=disable

# Optional: uncomment to override the defaults shown
# PORT=8080
# LOG_LEVEL=info
# Total SIGTERM-to-exit budget; keep below the platform kill grace period
# SHUTDOWN_TIMEOUT=9s
# DB_MAX_CONNS=10
# DB_STATEMENT_TIMEOUT=30s
# all = API + job workers in one process | api = API only | worker = jobs only
# (worker mode serves just /healthz and /readyz)
# RUN_MODE=all
# Concurrent jobs per worker process
# JOBS_MAX_WORKERS=10

# ----------------------------------------------------------------------------
# Firebase Auth (Phase 4)
# Default: the local Auth emulator (`make auth-up`), so `make run` works out of
# the box. To use your real dev project instead:
#   1. set FIREBASE_PROJECT_ID to it (console > Project settings > General)
#   2. comment out FIREBASE_AUTH_EMULATOR_HOST
#   3. optionally set FIREBASE_CREDENTIALS_JSON (needed for make grant-admin)
# ----------------------------------------------------------------------------

FIREBASE_PROJECT_ID=demo-farmish
# When set, the SDK talks to the emulator and SKIPS token signature checks.
# Dev/test only: the API refuses to start with it in staging/production.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Project settings > Service accounts > Generate new private key (JSON file).
# Either a path to that file (keep it OUTSIDE the repo), e.g.
#   FIREBASE_CREDENTIALS_JSON=/home/you/secrets/farmish-dev-sa.json
# or the whole file as ONE line in single quotes (jq -c . file.json).
# Not needed with the emulator; required in staging/production.
FIREBASE_CREDENTIALS_JSON=

# ----------------------------------------------------------------------------
# Cloudflare Turnstile (Phase 6)
# dash.cloudflare.com > Turnstile > Add widget > Secret key
# ----------------------------------------------------------------------------

# Required. Cloudflare's public test secret, which always passes, is fine for
# local dev (2x0000000000000000000000000000000AA always fails). The API refuses
# the test secrets in staging/production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ----------------------------------------------------------------------------
# Redis: shared rate limits (Upstash in hosted environments)
# Upstash console > your database > Connect > TCP (go-redis): the rediss:// URL.
# Single quotes; it contains the password. Unset = in-process limits only.
# Local alternative: `make redis-up` then redis://127.0.0.1:63790
# ----------------------------------------------------------------------------

# REDIS_URL='rediss://default:<password>@<name>.upstash.io:6379'
# Per-call budget before falling back to in-process limits. Deployed next to
# Upstash (same region) calls take a few ms. From a laptop far from the Upstash
# region they can take ~200ms, so raise it locally (e.g. 800ms) or use the
# local Redis instead.
# REDIS_TIMEOUT=200ms

# ----------------------------------------------------------------------------
# Client IP (Phase 6): which proxies' headers to believe for the real client
# address (rate limits, logs, Turnstile). Leave unset locally.
# ----------------------------------------------------------------------------

# Comma-separated CIDRs of proxies directly in front of the API (e.g. the
# hosting platform's edge). Their X-Forwarded-For entries are believed.
# TRUSTED_PROXIES=
# Believe CF-Connecting-IP when the request came from a Cloudflare edge address.
# TRUST_CLOUDFLARE=false

# ----------------------------------------------------------------------------
# Encryption at rest (Phase 8, used for payout account numbers in Phase 18)
# Generate once: openssl rand -base64 32
# Back it up (password manager). Losing it makes encrypted data unreadable.
# Use a DIFFERENT key in production.
# ----------------------------------------------------------------------------

DATA_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# Cloudflare R2 media storage (Phase 10)
# dash.cloudflare.com > R2
# ----------------------------------------------------------------------------

# R2 overview page > Account ID
R2_ACCOUNT_ID=
# R2 > Manage R2 API Tokens > Create API token (Object Read & Write, scoped to the bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name, e.g. farmish-media-dev
R2_BUCKET=
# Bucket > Settings > Public access: custom domain or r2.dev URL, no trailing slash
# e.g. https://media.farmish.gh
R2_PUBLIC_BASE_URL=

# ----------------------------------------------------------------------------
# Paystack payments (Phase 13)
# dashboard.paystack.com > Settings > API Keys & Webhooks
# Local: TEST keys only (sk_test_... / pk_test_...).
# ----------------------------------------------------------------------------

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ----------------------------------------------------------------------------
# mNotify: order/payout SMS alerts (Phase 16). Sign-in codes are sent by Firebase.
# mnotify.com > BMS dashboard > API settings
# ----------------------------------------------------------------------------

MNOTIFY_API_KEY=
# Approved sender ID. Use FARMISH once mNotify approves it, else your default.
MNOTIFY_SENDER=

# ----------------------------------------------------------------------------
# Marketplace rules (Phases 16-18): not secrets. Defaults are set in those phases.
# ----------------------------------------------------------------------------

# Days after delivery before an undisputed order auto-completes (Phase 16)
# ESCROW_AUTO_COMPLETE_DAYS=
# Hours a seller has to accept before the order auto-cancels (Phase 16)
# SELLER_ACCEPT_TIMEOUT_HOURS=
# Minimum payout in pesewas, e.g. 5000 = GHS 50.00 (Phase 18)
# PAYOUT_MIN_PESEWAS=
