# Copy to .env for local overrides (`cp .env.example .env`). Never commit .env.
# Phase 1 variables. Later phases append theirs (see REDEVELOPMENT_PLAN.md §7).

# Required: development | test | staging | production
APP_ENV=development
# Required: comma-separated browser origin allowlist (no *)
CORS_ORIGINS=http://localhost:3000

# Optional: uncomment to override the defaults shown
# PORT=8080
# LOG_LEVEL=info
# SHUTDOWN_TIMEOUT=15s
