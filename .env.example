# Copy to .env for local overrides (`cp .env.example .env`). Never commit .env.
# Later phases append their variables (see REDEVELOPMENT_PLAN.md §7).

# Required: development | test | staging | production
APP_ENV=development
# Required: comma-separated browser origin allowlist (no *)
CORS_ORIGINS=http://localhost:3000
# Required: Postgres URL. This is the docker-compose database (`make db-up`).
DATABASE_URL=postgres://farmish:farmish@127.0.0.1:54320/farmish?sslmode=disable

# Optional: uncomment to override the defaults shown
# PORT=8080
# LOG_LEVEL=info
# SHUTDOWN_TIMEOUT=15s
# DB_MAX_CONNS=10
# DB_STATEMENT_TIMEOUT=30s
